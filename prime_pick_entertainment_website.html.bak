          <div class="director-name">Asha Nair</div>
          <div class="director-films">2 Films · Malayalam</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ABOUT SECTION -->
  <div id="sec-about" style="display:none">
    <div class="section" style="max-width:740px;">
      <div class="section-eyebrow">Our Story</div>
      <h2 class="section-title">About Prime Pick Entertainment</h2>
      <div style="margin-bottom:3rem;">
        <p style="font-family:var(--cormorant); font-size:22px; font-style:italic; color:var(--text-secondary); line-height:1.7; margin-bottom:2rem; border-left:2px solid var(--gold); padding-left:1.5rem;">
          "We exist because powerful stories deserve to be discovered, studied, and celebrated."
        </p>
        <p style="font-size:14px; color:var(--text-secondary); line-height:1.9; margin-bottom:1.5rem;">
          Prime Pick Entertainment is India's independent cinema, storytelling, research, and filmmaking platform. We believe that independent short films are not merely entertainment — they are experiments in human perspective, laboratories of cinematic language, and windows into untold stories.
        </p>
        <p style="font-size:14px; color:var(--text-secondary); line-height:1.9; margin-bottom:2rem;">
          We do not follow trends. We set them. Through the Directors Challenge, Film Journal, Research Archive, and curated film library, we are building a home where filmmakers and film lovers can grow together.
        </p>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div style="background:var(--bg-secondary); border:1px solid rgba(200,155,60,0.15); border-radius:6px; padding:20px;">
          <div style="font-family:var(--cinzel); font-size:11px; font-weight:600; color:var(--gold); letter-spacing:0.15em; margin-bottom:8px;">Our Mission</div>
          <p style="font-size:12px; color:var(--text-secondary); line-height:1.7;">To discover, showcase, study, and celebrate powerful storytelling through short films, cinematic experiments, and filmmaking research.</p>
        </div>
        <div style="background:var(--bg-secondary); border:1px solid rgba(200,155,60,0.15); border-radius:6px; padding:20px;">
          <div style="font-family:var(--cinzel); font-size:11px; font-weight:600; color:var(--gold); letter-spacing:0.15em; margin-bottom:8px;">Our Vision</div>
          <p style="font-size:12px; color:var(--text-secondary); line-height:1.7;">To evolve into India's premier independent cinema network — film festival, film school, research institute, and OTT platform.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <div>
          <div class="footer-brand">
            <img src="/mnt/user-data/uploads/LOGO.png" alt="Prime Pick Entertainment" class="footer-brand-img" onerror="this.style.display='none'">
            <div>
              <div class="footer-brand-name">PRIME PICK ENTERTAINMENT</div>
              <div class="footer-brand-tagline">Stories · Cinema · Learning</div>
            </div>
          </div>
          <p class="footer-desc">India's independent cinema, storytelling, research & filmmaking platform. Discover award-winning short films, explore filmmaking insights, and experience stories across languages.</p>
          <div class="social-links">
            <div class="social-btn" title="YouTube"><i class="ti ti-brand-youtube" aria-hidden="true"></i></div>
            <div class="social-btn" title="Instagram"><i class="ti ti-brand-instagram" aria-hidden="true"></i></div>
            <div class="social-btn" title="Facebook"><i class="ti ti-brand-facebook" aria-hidden="true"></i></div>
            <div class="social-btn" title="LinkedIn"><i class="ti ti-brand-linkedin" aria-hidden="true"></i></div>
          </div>
        </div>
        <div>
          <div class="footer-col-title">Platform</div>
          <ul class="footer-links">
            <li><a onclick="showSection('films')">Films</a></li>
            <li><a onclick="showSection('challenge')">Directors Challenge</a></li>
            <li><a onclick="showSection('journal')">Film Journal</a></li>
            <li><a onclick="showSection('research')">Research</a></li>
            <li><a onclick="showSection('directors')">Directors</a></li>
          </ul>
        </div>
        <div>
          <div class="footer-col-title">Languages</div>
          <ul class="footer-links">
            <li><a>English</a></li>
            <li><a>తెలుగు</a></li>
            <li><a>ಕನ್ನಡ</a></li>
            <li><a>தமிழ்</a></li>
            <li><a>हिन्दी</a></li>
            <li><a>Malayalam</a></li>
          </ul>
        </div>
        <div>
          <div class="footer-col-title">Contact</div>
          <ul class="footer-links">
            <li><a>Film Submissions</a></li>
            <li><a>Collaborations</a></li>
            <li><a>Partnerships</a></li>
            <li><a>Media Enquiries</a></li>
            <li><a onclick="showSection('about')">About</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">© 2025 Prime Pick Entertainment. All rights reserved.</div>
        <div class="footer-positioning">Your First Choice for Great Stories</div>
      </div>
    </div>
  </footer>
</div>

<script>
  function showSection(id) {
    const sections = ['home','films','challenge','journal','research','directors','about'];
    sections.forEach(s => {
      const el = document.getElementById('sec-' + s);
      if (el) el.style.display = (s === id) ? 'block' : 'none';
    });
    document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
    const map = {home:0,films:1,challenge:2,journal:3,research:4,directors:5,about:6};
    const links = document.querySelectorAll('.nav-links a');
    if (map[id] !== undefined && links[map[id]]) links[map[id]].classList.add('active');
    document.querySelector('.ppe-root').scrollIntoView({behavior:'smooth'});
  }

  document.querySelectorAll('.page-tab').forEach(tab => {
    tab.addEventListener('click', function() {
      this.closest('.page-tabs').querySelectorAll('.page-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
    });
  });
</script>
